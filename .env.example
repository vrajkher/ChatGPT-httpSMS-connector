# Get this from your httpSMS account. Never commit the real key.
HTTPSMS_API_KEY=replace_me

# Android/SIM number registered in httpSMS, E.164 format.
HTTPSMS_FROM=+91XXXXXXXXXX

HTTPSMS_BASE_URL=https://api.httpsms.com
PORT=3000

# Strongly recommended before exposing /mcp publicly.
CONNECTOR_BEARER_TOKEN=replace_with_long_random_secret

# Optional: enables authenticated incoming SMS webhook processing.
HTTPSMS_WEBHOOK_TOKEN=replace_with_another_random_secret

# Optional: point to your real private contact master file.
# CONTACTS_FILE=./contacts.json
