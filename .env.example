# SMS Gateway for Android credentials shown in the app.
# Never commit the real username/password.
SMSGATE_USERNAME=replace_me
SMSGATE_PASSWORD=replace_me

# Cloud mode (recommended for ChatGPT connector deployment):
SMSGATE_BASE_URL=https://api.sms-gate.app/3rdparty/v1

# For local/LAN mode instead, use for example:
# SMSGATE_BASE_URL=http://192.168.1.123:8080

PORT=3000

# Strongly recommended before exposing /mcp publicly.
CONNECTOR_BEARER_TOKEN=replace_with_long_random_secret

# Optional: protect incoming SMS Gateway webhook receiver.
SMSGATE_WEBHOOK_TOKEN=replace_with_another_random_secret

# Optional: point to a real private contact master file.
# CONTACTS_FILE=./contacts.json
